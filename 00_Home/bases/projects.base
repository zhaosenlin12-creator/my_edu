filters:
  and:
    - file.folder == "20_Projects"
    - file.ext == "md"
properties:
  file.name:
    displayName: 项目
  note.status:
    displayName: 状态
  note.priority:
    displayName: 优先级
  note.deadline:
    displayName: 截止
  note.tags:
    displayName: 标签
views:
  - type: table
    name: 全部项目
    order:
      - file.name
      - status
      - priority
      - deadline
      - tags
  - type: table
    name: 进行中
    order:
      - file.name
      - priority
      - deadline
    filter:
      and:
        - note.status == "active"
  - type: table
    name: 高优先级
    order:
      - file.name
      - status
      - deadline
    filter:
      and:
        - note.priority == "high"
