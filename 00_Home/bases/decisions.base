filters:
  and:
    - file.folder == "decisions"
    - file.ext == "md"
    - file.name != "README.md"
properties:
  file.name:
    displayName: 决策标题
  note.status:
    displayName: 状态
  note.date:
    displayName: 日期
  note.tags:
    displayName: 标签
views:
  - type: table
    name: 时间线
    order:
      - date
      - file.name
      - status
      - tags
  - type: table
    name: 待复审
    order:
      - date
      - file.name
      - tags
    filter:
      and:
        - note.status != "superseded"
  - type: table
    name: 已废止
    order:
      - date
      - file.name
    filter:
      and:
        - note.status == "superseded"
