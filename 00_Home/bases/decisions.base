filters:
  and:
    - file.folder == "decisions"
    - file.ext == "md"
    - file.name != "README.md"
properties:
  file.name:
    displayName: 决策标题
  note.status:
    displayName: 状态
  note.date:
    displayName: 日期
  note.tags:
    displayName: 标签
views:
  - type: table
    name: 时间线
    order:
      - note.date
      - file.name
      - note.status
      - note.tags
  - type: table
    name: 待复审
    filter:
      and:
        - note.status != "superseded"
    order:
      - note.date
      - file.name
      - note.tags
  - type: table
    name: 已废止
    filter:
      and:
        - note.status == "superseded"
    order:
      - note.date
      - file.name