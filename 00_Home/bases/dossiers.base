filters:
  and:
    - file.folder == "60_Assets/dossiers"
    - file.ext == "md"
properties:
  file.name:
    displayName: Dossier
  note.type:
    displayName: 类型
  note.status:
    displayName: 状态
  note.tags:
    displayName: 标签
views:
  - type: table
    name: 全部 Dossier
    order:
      - file.name
      - status
      - tags
  - type: table
    name: 待补充
    order:
      - file.name
      - tags
    filter:
      and:
        - note.status != "complete"
